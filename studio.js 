  `;

  $('settingsUploadBtn')?.addEventListener('click', openUploadModal);
  $('settingsLogoutBtn')?.addEventListener('click', handleSignOut);
}

async function handleSignOut() {
  if (!confirm('Log out?')) return;
  await signOut(auth);
  window.location.href = 'index.html';
}

/* ============================================================
   UPLOAD MODAL
   ============================================================ */
function openUploadModal() {
  resetUploadPreview();
  currentUploadType = 'short';
  document.querySelectorAll('.studio-upload-tab').forEach(t => {
    t.classList.toggle('active', t.dataset.type === 'short');
  });
  updatePickerText();
  $('studioCaption').value = '';
  $('studioMsg').textContent = '';
  $('studioMsg').className = 'studio-msg';
  $('studioProgressWrap').style.display = 'none';
  $('studioProgressBar').style.width = '0%';
  $('studioProgressText').textContent = '0%';
  $('studioUploadModal').classList.add('show');
}

function closeUploadModal() {
  $('studioUploadModal').classList.remove('show');
  resetUploadPreview();
}

function resetUploadPreview() {
  selectedFile = null;
  selectedFileDuration = 0;
  $('studioFileInput').value = '';
  $('studioPreviewWrap').style.display = 'none';
  $('studioPreviewVid').src = '';
  $('studioPreviewImg').src = '';
  $('studioPreviewImg').style.display = 'none';
  $('studioPreviewVid').style.display = 'none';
  $('studioPickerWrap').style.display = 'flex';
  $('studioSubmitBtn').disabled = true;
}

function updatePickerText() {
  if (currentUploadType === 'photo') {
    $('studioPickerTitle').textContent = 'Choose a photo';
    $('studioPickerSub').textContent = 'JPG / PNG · Max 5 MB';
    $('studioPickerLabel').textContent = 'Select photo';
    $('studioFileInput').accept = 'image/*';
  } else if (currentUploadType === 'long') {
    $('studioPickerTitle').textContent = 'Choose a video';
    $('studioPickerSub').textContent = 'Max 1 min · 16:9';
    $('studioPickerLabel').textContent = 'Select video';
    $('studioFileInput').accept = 'video/*';
  } else {
    $('studioPickerTitle').textContent = 'Choose a short video';
    $('studioPickerSub').textContent = 'Max 60 sec · 9:16';
    $('studioPickerLabel').textContent = 'Select video';
    $('studioFileInput').accept = 'video/*';
  }
}

function handleFileSelect(e) {
  const file = e.target.files[0];
  if (!file) return;

  $('studioMsg').textContent = '';
  $('studioMsg').className = 'studio-msg';

  if (currentUploadType === 'photo') {
    if (!file.type.startsWith('image/')) {
      $('studioMsg').textContent = 'Choose an image.';
      return;
    }
    if (file.size > 5 * 1024 * 1024) {
      $('studioMsg').textContent = 'Max 5 MB.';
      return;
    }
    selectedFile = file;
    $('studioPreviewImg').src = URL.createObjectURL(file);
    $('studioPreviewImg').style.display = 'block';
    $('studioPreviewVid').style.display = 'none';
    $('studioPreviewWrap').style.display = 'block';
    $('studioPickerWrap').style.display = 'none';
    $('studioSubmitBtn').disabled = false;
    return;
  }

  if (!file.type.startsWith('video/')) {
    $('studioMsg').textContent = 'Choose a video.';
    return;
  }
  if (file.size > 500 * 1024 * 1024) {
    $('studioMsg').textContent = 'Max 500 MB.';
    return;
  }

  const url = URL.createObjectURL(file);
  const tempVid = document.createElement('video');
  tempVid.preload = 'metadata';
  tempVid.src = url;

  tempVid.onloadedmetadata = () => {
    const dur = tempVid.duration;
    if (!isFinite(dur) || dur <= 0) {
      $('studioMsg').textContent = 'Could not read duration.';
      return;
    }
    selectedFile = file;
    selectedFileDuration = dur;

    $('studioPreviewVid').src = url;
    $('studioPreviewVid').style.display = 'block';
    $('studioPreviewImg').style.display = 'none';
    $('studioPreviewInfo').textContent = `${Math.round(dur)}s · ${(file.size / 1024 / 1024).toFixed(2)} MB`;
    $('studioPreviewWrap').style.display = 'block';
    $('studioPickerWrap').style.display = 'none';
    $('studioSubmitBtn').disabled = false;
  };

  tempVid.onerror = () => {
    $('studioMsg').textContent = 'Could not load video.';
  };
}

async function handleUpload() {
  if (!selectedFile) {
    $('studioMsg').textContent = 'Select a file.';
    return;
  }

  $('studioSubmitBtn').disabled = true;
  $('studioSubmitBtn').textContent = 'Uploading...';
  $('studioMsg').textContent = '';
  $('studioMsg').className = 'studio-msg';
  $('studioProgressWrap').style.display = 'block';

  try {
    const result = await uploadToCloudinary(selectedFile, (pct) => {
      $('studioProgressBar').style.width = pct + '%';
      $('studioProgressText').textContent = pct + '%';
    });

    const postData = {
      userId: currentUser.uid,
      userName: currentProfile.name,
      userHandle: currentProfile.user,
      userPhoto: currentProfile.photo || '',
      userVerified: currentProfile.verified || false,
      type: currentUploadType,
      url: result.secure_url,
      thumbnail: buildThumbnailUrl(result.secure_url, currentUploadType),
      caption: $('studioCaption').value.trim(),
      duration: selectedFileDuration || 0,
      aspectRatio: currentUploadType === 'long' ? '16:9' : (currentUploadType === 'short' ? '9:16' : '1:1'),
      likes: [],
      commentsCount: 0,
      views: 0,
      shares: 0,
      createdAt: serverTimestamp()
    };

    await addDoc(collection(db, 'posts'), postData);

    await updateDoc(doc(db, 'users', currentUser.uid), {
      videoCount: (currentProfile.videoCount || 0) + 1
    });
    currentProfile.videoCount = (currentProfile.videoCount || 0) + 1;

    $('studioMsg').className = 'studio-msg success';
    $('studioMsg').textContent = '✅ Uploaded!';

    await loadAllPosts();

    setTimeout(() => {
      closeUploadModal();
      renderCurrentTab();
    }, 1200);

  } catch (e) {
    console.error(e);
    $('studioMsg').className = 'studio-msg';
    $('studioMsg').textContent = e.message || 'Upload failed.';
    $('studioSubmitBtn').disabled = false;
    $('studioSubmitBtn').textContent = 'Upload to ReelHub';
  }
}

function uploadToCloudinary(file, onProgress) {
  return new Promise((resolve, reject) => {
    const resourceType = currentUploadType === 'photo' ? 'image' : 'video';
    const url = `https://api.cloudinary.com/v1_1/${CLOUDINARY.cloudName}/${resourceType}/upload`;

    const fd = new FormData();
    fd.append('file', file);
    fd.append('upload_preset', CLOUDINARY.preset);
    fd.append('api_key', CLOUDINARY.apiKey);

    const xhr = new XMLHttpRequest();
    xhr.open('POST', url, true);
    xhr.timeout = 180000;

    xhr.upload.onprogress = (e) => {
      if (e.lengthComputable && onProgress) {
        onProgress(Math.round((e.loaded / e.total) * 100));
      }
    };

    xhr.onload = () => {
      if (xhr.status >= 200 && xhr.status < 300) {
        try {
          const res = JSON.parse(xhr.responseText);
          if (!res.secure_url) reject(new Error('No URL returned'));
          else resolve(res);
        } catch (e) {
          reject(new Error('Invalid response'));
        }
      } else {
        let msg = 'Upload failed';
        try {
          const d = JSON.parse(xhr.responseText);
          if (d.error?.message) msg = d.error.message;
        } catch (e) {}
        reject(new Error(msg));
      }
    };

    xhr.onerror = () => reject(new Error('Network error'));
    xhr.ontimeout = () => reject(new Error('Timeout'));
    xhr.send(fd);
  });
}

function buildThumbnailUrl(url, type) {
  if (!url) return '';

  try {
    if (type === 'photo') return url;

    if (url.includes('/video/upload/')) {
      const parts = url.split('/video/upload/');
      if (parts.length === 2) {
        let pid = parts[1].replace(/^v\d+\//, '').replace(/\.[^.]+$/, '');
        return `https://res.cloudinary.com/${CLOUDINARY.cloudName}/video/upload/so_auto,w_400,h_711,c_fill,q_auto/${pid}.jpg`;
      }
    }
  } catch (e) {}

  return '';
}

/* ============================================================
   HELPERS
   ============================================================ */
function escapeHtml(str) {
  if (str == null) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function defaultAvatar(name) {
  const raw = (name || '?').trim().charAt(0).toUpperCase();
  const letter = raw.replace(/[<>&"']/g, '') || '?';
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="#1e1e28"/><text x="50" y="50" font-size="44" font-family="sans-serif" font-weight="700" fill="#fff" text-anchor="middle" dominant-baseline="central">${letter}</text></svg>`;
  return 'data:image/svg+xml;utf8,' + encodeURIComponent(svg);
}

function formatNum(n) {
  n = parseInt(n) || 0;
  if (n >= 1000000) return (n / 1000000).toFixed(1).replace(/\.0$/, '') + 'M';
  if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'K';
  return n.toString();
}

function timeAgo(date) {
  if (!date) return 'just now';
  const s = Math.floor((new Date() - date) / 1000);
  if (s < 60) return 'just now';
  const m = Math.floor(s / 60);
  if (m < 60) return m + 'm ago';
  const h = Math.floor(m / 60);
  if (h < 24) return h + 'h ago';
  const d = Math.floor(h / 24);
  if (d < 7) return d + 'd ago';
  return Math.floor(d / 7) + 'w ago';
}

function toast(msg) {
  let t = document.getElementById('studioToast');
  if (!t) {
    t = document.createElement('div');
    t.id = 'studioToast';
    document.body.appendChild(t);
  }
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(window._stToast);
  window._stToast = setTimeout(() => t.classList.remove('show'), 2200);
}


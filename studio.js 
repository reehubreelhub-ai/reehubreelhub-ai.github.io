async function loadUserList(uids, containerId) {
  const wrap = $(containerId);
  if (!wrap) return;

  if (uids.length === 0) {
    wrap.innerHTML = `<div class="studio-empty"><p>No users yet</p></div>`;
    return;
  }

  const users = [];
  for (const uid of uids.slice(0, 50)) {
    try {
      const snap = await getDoc(doc(db, 'users', uid));
      if (snap.exists()) users.push({ uid, ...snap.data() });
    } catch (e) {}
  }

  if (users.length === 0) {
    wrap.innerHTML = `<div class="studio-empty"><p>Users not found</p></div>`;
    return;
  }

  wrap.innerHTML = users.map(u => `
    <div class="studio-user-row" style="display:flex;align-items:center;gap:12px;padding:10px 4px;">
      <img src="${u.photo || defaultAvatar(u.name)}" style="width:42px;height:42px;border-radius:50%;object-fit:cover;" alt="">
      <div style="flex:1;min-width:0;">
        <div style="font-size:14px;font-weight:700;">${escapeHtml(u.name || 'User')}</div>
        <div style="font-size:12px;color:#888;">@${escapeHtml(u.user || '')}</div>
      </div>
    </div>
  `).join('');
}


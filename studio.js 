/* ============================================================
   WEEK CHART
   ============================================================ */
function drawWeekChart() {
  const days = [];
  for (let i = 6; i >= 0; i--) {
    const d = new Date();
    d.setDate(d.getDate() - i);
    d.setHours(0, 0, 0, 0);
    const next = new Date(d);
    next.setDate(next.getDate() + 1);

    const views = allPosts.reduce((sum, p) => {
      const t = p.createdAt?.toDate?.()?.getTime?.() || 0;
      if (t >= d.getTime() && t < next.getTime()) return sum + (p.views || 0);
      return sum;
    }, 0);

    days.push({
      label: d.toLocaleDateString('en', { weekday: 'short' }),
      views
    });
  }

  const max = Math.max(1, ...days.map(d => d.views));
  const chart = $('studioChart');
  if (!chart) return;

  chart.innerHTML = days.map(d => {
    const h = Math.max(4, (d.views / max) * 100);
    return `
      <div class="studio-chart-bar-wrap">
        <div class="studio-chart-bar" style="height: ${h}%"></div>
        <div class="studio-chart-label">${d.label}</div>
      </div>
    `;
  }).join('');
}


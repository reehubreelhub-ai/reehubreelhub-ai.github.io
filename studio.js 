        <div>
          <div style="font-size:16px;font-weight:800;">${escapeHtml(currentProfile?.name || '')}</div>
          <div style="font-size:13px;color:#888;">@${escapeHtml(currentProfile?.user || '')}</div>
          <div style="font-size:12px;color:#666;margin-top:4px;">${escapeHtml(currentUser.email || '')}</div>
        </div>
      </div>
      <button class="studio-upload-btn" style="margin-top:16px" onclick="window.location.href='index.html'">
        Open Full Settings
      </button>
    </div>

    <div class="studio-section">
      <div class="studio-section-header">
        <div class="studio-section-title">Quick Actions</div>
      </div>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <button class="studio-upload-btn" id="settingsUploadBtn" style="width:100%;justify-content:center;">
          <svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>

onAuthStateChanged(auth, async (user) => {
  if (!user) {
    window.location.href = 'index.html';
    return;
  }
  currentUser = user;

  await loadProfile();
  await loadAllPosts();

  initUI();
  renderCurrentTab();

  $('studioLoading').style.display = 'none';
  $('studioApp').style.display = 'flex';
});

async function loadProfile() {
  try {
    const snap = await getDoc(doc(db, 'users', currentUser.uid));
    if (snap.exists()) {
      currentProfile = { uid: snap.id, ...snap.data() };
      if (!Array.isArray(currentProfile.followers)) currentProfile.followers = [];
      if (!Array.isArray(currentProfile.following)) currentProfile.following = [];
      if (!Array.isArray(currentProfile.savedPosts)) currentProfile.savedPosts = [];
      if (typeof currentProfile.videoCount !== 'number') currentProfile.videoCount = 0;
    }
  } catch (e) {
    console.error('loadProfile error:', e);
  }
}

async function loadAllPosts() {
  try {
    const q = query(collection(db, 'posts'), where('userId', '==', currentUser.uid));
    const snap = await getDocs(q);
    allPosts = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    allPosts.sort((a, b) =>
      (b.createdAt?.toDate?.()?.getTime() || 0) -
      (a.createdAt?.toDate?.()?.getTime() || 0)
    );
  } catch (e) {
    console.error('loadAllPosts error:', e);
    allPosts = [];
  }
}


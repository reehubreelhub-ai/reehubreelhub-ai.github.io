function showVideoMenu(anchor, post) {
  document.querySelectorAll('.studio-menu-dropdown').forEach(el => el.remove());

  const menu = document.createElement('div');
  menu.className = 'studio-menu-dropdown';
  menu.style.cssText = `
    position: fixed;
    background: #1e1e28;
    border: 1px solid #333;
    border-radius: 10px;
    padding: 6px;
    min-width: 170px;
    z-index: 9999;
    box-shadow: 0 8px 24px rgba(0,0,0,0.6);
  `;
  menu.innerHTML = `
    <button data-act="view" style="display:flex;align-items:center;gap:10px;width:100%;padding:10px 12px;background:none;border:none;color:#fff;font-size:13px;font-weight:600;text-align:left;border-radius:6px;cursor:pointer;">
      👁 View in app
    </button>
    <button data-act="edit" style="display:flex;align-items:center;gap:10px;width:100%;padding:10px 12px;background:none;border:none;color:#fff;font-size:13px;font-weight:600;text-align:left;border-radius:6px;cursor:pointer;">
      ✏️ Edit caption
    </button>
    <div style="height:1px;background:#333;margin:4px 0;"></div>
    <button data-act="delete" style="display:flex;align-items:center;gap:10px;width:100%;padding:10px 12px;background:none;border:none;color:#ff4d4d;font-size:13px;font-weight:600;text-align:left;border-radius:6px;cursor:pointer;">
      🗑 Delete
    </button>
  `;
  document.body.appendChild(menu);

  const r = anchor.getBoundingClientRect();
  const mr = menu.getBoundingClientRect();
  let top = r.bottom + 5;
  let left = r.right - mr.width;
  if (top + mr.height > window.innerHeight - 10) top = r.top - mr.height - 5;
  if (left < 10) left = 10;
  menu.style.top = top + 'px';
  menu.style.left = left + 'px';

  menu.querySelectorAll('button').forEach(b => {
    b.onmouseenter = () => b.style.background = '#2a2a34';
    b.onmouseleave = () => b.style.background = 'none';
    b.onclick = async (e) => {
      e.stopPropagation();
      menu.remove();
      const act = b.dataset.act;
      if (act === 'view') window.open('index.html', '_blank');
      else if (act === 'edit') await editCaption(post);
      else if (act === 'delete') await deletePost(post);
    };
  });

  setTimeout(() => {
    const close = (ev) => {
      if (!menu.contains(ev.target) && ev.target !== anchor) {
        menu.remove();
        document.removeEventListener('click', close);
      }
    };
    document.addEventListener('click', close);
  }, 100);
}

async function editCaption(post) {
  const newCap = prompt('Edit caption:', post.caption || '');
  if (newCap === null || newCap === post.caption) return;

  try {
    await updateDoc(doc(db, 'posts', post.id), { caption: newCap.trim() });
    const p = allPosts.find(x => x.id === post.id);
    if (p) p.caption = newCap.trim();
    toast('✅ Caption updated');
    renderVideosTab();
  } catch (e) {
    toast('❌ Update failed');
  }
}

async function deletePost(post) {
  if (!confirm('Delete this post permanently?')) return;

  try {
    await deleteDoc(doc(db, 'posts', post.id));
    await updateDoc(doc(db, 'users', currentUser.uid), {
      videoCount: Math.max(0, (currentProfile.videoCount || 1) - 1)
    });
    currentProfile.videoCount = Math.max(0, (currentProfile.videoCount || 1) - 1);
    allPosts = allPosts.filter(p => p.id !== post.id);
    toast('🗑 Deleted');
    renderVideosTab();
  } catch (e) {
    toast('❌ Delete failed');
  }
}

